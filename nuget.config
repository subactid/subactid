<?xml version="1.0" encoding="utf-8"?>
<!-- One package source, and every package mapped to it, so a package name registered on another
     feed can never be substituted (dependency confusion). The lock file beside each project pins
     the versions. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
