{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Subact ID chart values",
  "description": "Every value the chart reads, by shape, and no other: a mistyped name fails the render instead of being ignored. Whether a value is required, and what to do when it is missing, is decided by the templates, which say so in words.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "issuer": {
      "type": "string"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "repository"
      ]
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issuer": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "metadataUrl": {
          "type": "string"
        },
        "subjectTokenTypes": {
          "type": "string"
        },
        "sponsorKeyClaim": {
          "type": "string"
        },
        "sponsorCheck": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "poll",
                "signals"
              ]
            },
            "clientId": {
              "type": "string"
            },
            "usersUrl": {
              "type": "string"
            },
            "tokenUrl": {
              "type": "string"
            },
            "cacheTtl": {
              "$ref": "#/definitions/duration"
            }
          }
        },
        "backchannelLogout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "audience": {
              "type": "string"
            }
          }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string",
          "minLength": 1
        },
        "migration": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "existingSecretKey": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "signing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "mountPath": {
          "type": "string",
          "minLength": 1
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "kid": {
                "type": "string"
              }
            },
            "required": [
              "key"
            ]
          }
        },
        "activeKid": {
          "type": "string"
        }
      }
    },
    "admin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sink": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "existingSecretKey": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "drainInterval": {
          "$ref": "#/definitions/duration"
        },
        "drainBatchSize": {
          "$ref": "#/definitions/optionalInteger"
        },
        "checkpointInterval": {
          "$ref": "#/definitions/duration"
        },
        "retention": {
          "$ref": "#/definitions/duration"
        },
        "partitionMonthsAhead": {
          "$ref": "#/definitions/optionalInteger"
        },
        "aggregation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "$ref": "#/definitions/optionalBoolean"
            },
            "window": {
              "$ref": "#/definitions/duration"
            }
          }
        }
      }
    },
    "rateLimit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "$ref": "#/definitions/optionalBoolean"
        },
        "permitsPerMinute": {
          "$ref": "#/definitions/optionalInteger"
        },
        "burst": {
          "$ref": "#/definitions/optionalInteger"
        },
        "trustedProxies": {
          "type": "string"
        },
        "signals": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "permitsPerMinute": {
              "$ref": "#/definitions/optionalInteger"
            },
            "burst": {
              "$ref": "#/definitions/optionalInteger"
            }
          }
        },
        "introspection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "permitsPerMinute": {
              "$ref": "#/definitions/optionalInteger"
            },
            "burst": {
              "$ref": "#/definitions/optionalInteger"
            }
          }
        }
      }
    },
    "overload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "$ref": "#/definitions/optionalBoolean"
        },
        "concurrencyLimit": {
          "$ref": "#/definitions/optionalInteger"
        },
        "queueLimit": {
          "$ref": "#/definitions/optionalInteger"
        },
        "queueTimeout": {
          "$ref": "#/definitions/duration"
        }
      }
    },
    "allowInsecureHttp": {
      "$ref": "#/definitions/optionalBoolean"
    },
    "agentKeys": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blockPrivateNetworks": {
          "$ref": "#/definitions/optionalBoolean"
        }
      }
    },
    "scim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string",
          "minLength": 1
        },
        "previousSecretKey": {
          "type": "string"
        },
        "sponsorKeyAttribute": {
          "type": "string",
          "enum": [
            "",
            "externalId",
            "userName"
          ]
        },
        "maxUsers": {
          "$ref": "#/definitions/optionalInteger"
        }
      }
    },
    "ssf": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issuer": {
          "type": "string"
        },
        "audience": {
          "type": "string"
        },
        "existingSecret": {
          "type": "string"
        },
        "existingSecretKey": {
          "type": "string",
          "minLength": 1
        },
        "previousSecretKey": {
          "type": "string"
        }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultTaskTtl": {
          "$ref": "#/definitions/duration"
        },
        "defaultTokenTtl": {
          "$ref": "#/definitions/duration"
        }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minTaskTtl": {
          "$ref": "#/definitions/duration"
        },
        "maxTaskTtl": {
          "$ref": "#/definitions/duration"
        },
        "minTokenTtl": {
          "$ref": "#/definitions/duration"
        },
        "maxTokenTtl": {
          "$ref": "#/definitions/duration"
        }
      }
    },
    "tasks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sweepInterval": {
          "$ref": "#/definitions/duration"
        },
        "sweepBatchSize": {
          "$ref": "#/definitions/optionalInteger"
        },
        "retention": {
          "$ref": "#/definitions/duration"
        }
      }
    },
    "revocations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "signOutRetention": {
          "$ref": "#/definitions/duration"
        }
      }
    },
    "migrate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "containerPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tls": {
          "$ref": "#/definitions/tls"
        },
        "admin": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "className": {
              "type": "string"
            },
            "host": {
              "type": "string"
            },
            "annotations": {
              "type": "object"
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tls": {
              "$ref": "#/definitions/tls"
            }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "database": {
          "$ref": "#/definitions/egressPeer"
        },
        "upstream": {
          "$ref": "#/definitions/egressPeer"
        },
        "ingressFrom": {
          "$ref": "#/definitions/peer"
        },
        "dns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "namespaceSelector": {
              "type": "object"
            }
          }
        },
        "extraEgress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "resources": {
      "type": "object"
    },
    "logging": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimumLevel": {
          "type": "string"
        },
        "overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "extraEnv": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "string"
          },
          "valueFrom": {
            "type": "object"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "topologySpreadConstraints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "duration": {
      "type": "string",
      "description": "An ISO 8601 duration such as PT5M, or a time span such as 00:05:00. Empty is the server default."
    },
    "optionalInteger": {
      "description": "A whole number. Empty is the server default.",
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^[0-9]*$"
        }
      ]
    },
    "optionalBoolean": {
      "description": "true or false. Empty is the server default.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "enum": [
            "",
            "true",
            "false"
          ]
        }
      ]
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "secretName": {
          "type": "string"
        }
      }
    },
    "peer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "podSelector": {
          "type": "object"
        },
        "namespaceSelector": {
          "type": "object"
        },
        "cidrs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "egressPeer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "podSelector": {
          "type": "object"
        },
        "namespaceSelector": {
          "type": "object"
        },
        "cidrs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        }
      }
    }
  }
}
